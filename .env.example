# ── AnswerDe environment (template — safe to commit) ────────────────
# Copy this file to `.env.local` and fill in your real values.

# Neon Postgres connection string (Serverless driver)
# Example: postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=""

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=""

# ── Neon Auth (Managed Better Auth) ──────────────────────────────────
# Copy your Auth URL from the Neon Console: Project → Branch → Auth →
# Configuration → "Auth URL". It looks like:
#   https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=""

# Cookie secret for signing the session cookie (at least 32 characters).
# Generate one with:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# ── PayU payment gateway ────────────────────────────────────────────
# Get these from the PayU dashboard. `PAYU_MODE` is "test" or "prod".
PAYU_MERCHANT_KEY=""
PAYU_SALT=""
PAYU_MODE="test"
